# NEXT_PUBLIC_* values are baked in at build time, and .env.local overrides .env (see README)
PORT=3000
HOST=127.0.0.1
SSL_CERT_PATH=/path/to/localhost.crt
SSL_KEY_PATH=/path/to/localhost.key
# Used for server-side API requests. On production this is http://api.mlpvector.club on purpose:
# /etc/hosts points it at the local nginx, whose certificate Node doesn't trust (see README)
NEXT_PUBLIC_BACKEND_HOST=https://api.example.com
# The public URL of the site, used for canonical links, og: tags and share links
NEXT_PUBLIC_FRONTEND_HOST=https://example.com
NEXT_PUBLIC_CDN_DOMAIN=cdn.example.com
NEXT_PUBLIC_API_PREFIX=/api
